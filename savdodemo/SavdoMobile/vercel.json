{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "installCommand": "echo 'Using buildCommand npm install'",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/pos.html",
      "dest": "/pos.html"
    },
    {
      "src": "/receipt.html",
      "dest": "/receipt.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
